# AgentForge 生成的 .env.example —— 由 integration pack manifest 汇总，请勿写入真实值。
# 秘密字段一律留空；真实凭据仅在部署环境/Secret Store 注入，禁止提交到仓库。

# 天气服务基站地址 | kind=base_url | 秘密=否 | 必需模式=live
WEATHER_API_BASE_URL=https://example.invalid/
# 天气服务 API Key | kind=secret_key | 秘密=是 | 必需模式=live
WEATHER_API_KEY=
# 天气服务 AppID | kind=app_id | 秘密=否 | 必需模式=live
WEATHER_APP_ID=example-app-id
