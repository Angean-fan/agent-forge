{
  "schema_version": "0.1",
  "project_type": "crud_web",
  "goal": "图书借阅管理：管理员维护图书，读者可借阅与归还。",
  "actors": ["ADMIN", "MEMBER"],
  "entities": [
    {
      "name": "Book",
      "source": "user_confirmed",
      "fields": [
        {"name": "id", "type": "long", "required": true},
        {"name": "title", "type": "string", "required": true},
        {"name": "isbn", "type": "string", "required": true},
        {"name": "status", "type": "string", "required": true},
        {"name": "owner_id", "type": "long", "required": true},
        {"name": "created_at", "type": "datetime", "required": true}
      ]
    },
    {
      "name": "Loan",
      "source": "user_confirmed",
      "fields": [
        {"name": "id", "type": "long", "required": true},
        {"name": "borrower_id", "type": "long", "required": true},
        {"name": "owner_id", "type": "long", "required": true},
        {"name": "status", "type": "string", "required": true},
        {"name": "created_at", "type": "datetime", "required": true}
      ]
    }
  ],
  "relations": [
    {"child": "Loan", "parent": "Book", "kind": "many-to-one", "unique": false}
  ],
  "pages": [],
  "permissions": [
    {"role": "ADMIN", "actions": ["create", "read", "update", "delete"], "source": "user_confirmed"},
    {"role": "MEMBER", "actions": ["create", "read"], "source": "user_confirmed"}
  ],
  "business_rules": [
    {"id": "BR01", "text": "读者只能查看自己的借阅记录", "source": "user_confirmed"},
    {"id": "BR02", "text": "同一本书不可被重复借出", "source": "user_confirmed"}
  ],
  "acceptance_cases": [
    {
      "id": "AC01",
      "scenario": "读者借阅一本可借图书",
      "expected": "生成借阅记录且图书状态变为已借出",
      "source": "user_confirmed"
    },
    {
      "id": "AC02",
      "scenario": "读者尝试借阅已被借出的图书",
      "expected": "请求被拒绝，提示图书不可借",
      "source": "user_confirmed"
    }
  ],
  "technical_profile": {
    "profile_id": "demo-ts-mp",
    "profile_version": "0.3",
    "template_version": "demo-0.2"
  },
  "constraints": ["Demo 支持 1—3 个业务实体", "借阅关系为一对多（Loan → Book）"],
  "exclusions": ["不做注册与找回密码", "不做逾期罚金结算"],
  "capability_requests": [],
  "recipe_requests": [],
  "integrations": [],
  "external_requirements": []
}
