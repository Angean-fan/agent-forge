{
  "id": "task-crud-backend",
  "version": "0.1.0",
  "kind": "capability-pack",
  "compatible_profiles": [
    "demo-ts-mp"
  ],
  "requires": [
    "template:auth",
    "template:exception-handling",
    "template:mybatis-plus"
  ],
  "provides": [
    "crud",
    "pagination",
    "search",
    "data_ownership"
  ],
  "conflicts": [],
  "extension_points": [],
  "checksum": "ab27d23b844167c9936258b7f2c4b970cce53ca8a1681aff9e1d43e5a07b1230",
  "parameter_schema": {
    "entity_name": "string",
    "table_name": "string",
    "plural": "string",
    "fields": "ColumnContract[]",
    "writable_fields": "FieldContract[]",
    "view_fields": "FieldContract[]"
  },
  "owned_paths": [
    "src/main/java/com/agentforge/template/entity/",
    "src/main/java/com/agentforge/template/mapper/",
    "src/main/java/com/agentforge/template/service/",
    "src/main/java/com/agentforge/template/controller/",
    "src/main/java/com/agentforge/template/dto/",
    "src/main/java/com/agentforge/template/vo/",
    "src/main/java/com/agentforge/template/config/MybatisPlusConfig.java",
    "src/main/resources/db/migration/V2__create_*.sql",
    "src/test/java/com/agentforge/template/"
  ],
  "dependencies": [
    {
      "groupId": "com.baomidou",
      "artifactId": "mybatis-plus-jsqlparser",
      "version": "3.5.17"
    }
  ],
  "checks": [
    "mvn test",
    "mvn package"
  ],
  "license": "internal",
  "renders": [
    {
      "template": "entity.java.j2",
      "target": "src/main/java/{{ package_dir }}/entity/{{ entity_name }}.java"
    },
    {
      "template": "mapper.java.j2",
      "target": "src/main/java/{{ package_dir }}/mapper/{{ entity_name }}Mapper.java"
    },
    {
      "template": "dto_create.java.j2",
      "target": "src/main/java/{{ package_dir }}/dto/{{ entity_name }}CreateRequest.java"
    },
    {
      "template": "dto_update.java.j2",
      "target": "src/main/java/{{ package_dir }}/dto/{{ entity_name }}UpdateRequest.java"
    },
    {
      "template": "vo_view.java.j2",
      "target": "src/main/java/{{ package_dir }}/vo/{{ entity_name }}View.java"
    },
    {
      "template": "vo_page.java.j2",
      "target": "src/main/java/{{ package_dir }}/vo/PageResult.java"
    },
    {
      "template": "config.java.j2",
      "target": "src/main/java/{{ package_dir }}/config/MybatisPlusConfig.java"
    },
    {
      "template": "service.java.j2",
      "target": "src/main/java/{{ package_dir }}/service/{{ entity_name }}Service.java"
    },
    {
      "template": "controller.java.j2",
      "target": "src/main/java/{{ package_dir }}/controller/{{ entity_name }}Controller.java"
    },
    {
      "template": "migration.sql.j2",
      "target": "src/main/resources/db/migration/V2__create_{{ table_name }}.sql"
    },
    {
      "template": "test_api.java.j2",
      "target": "src/test/java/{{ package_dir }}/{{ entity_name }}ApiTest.java"
    }
  ]
}
