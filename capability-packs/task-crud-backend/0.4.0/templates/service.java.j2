import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

/** 固定借阅主线：行锁串行化同书借阅；借出/归还与 Loan 写入同事务。 */
@Service
public class LoanService {
    private final LoanMapper mapper;
    private final BookMapper bookMapper;

    public LoanService(LoanMapper mapper, BookMapper bookMapper) {
        this.mapper = mapper;
        this.bookMapper = bookMapper;
    }

    public PageResult<LoanView> list(long page, long size, String keyword, Long ownerId) {
        LambdaQueryWrapper<Loan> query = new LambdaQueryWrapper<>();
        query.eq(Loan::getOwnerId, ownerId);
        if (keyword != null && !keyword.isBlank()) {
            query.like(Loan::getStatus, keyword);
        }
        query.orderByDesc(Loan::getId);
        Page<Loan> result = mapper.selectPage(new Page<>(page, size), query);
        return new PageResult<>(
                result.getRecords().stream().map(this::toView).toList(),
                result.getTotal(), result.getCurrent(), result.getSize());
    }

    @Transactional
    public LoanView create(LoanCreateRequest request, Long ownerId) {
        if (request.book_id() == null) {
            throw new ApiException(ErrorCode.BAD_REQUEST, "必须指定图书", 400);
        }
        Book book = lockedBook(request.book_id());
        if (mapper.selectCount(new LambdaQueryWrapper<Loan>()
                .eq(Loan::getBookId, book.getId()).eq(Loan::getStatus, "ACTIVE")) > 0) {
            throw new ApiException("CONFLICT", "图书已有有效借阅", 409);
        }
        if (!"AVAILABLE".equals(book.getStatus())) {
            throw new ApiException("CONFLICT", "图书不可借", 409);
        }
        Loan loan = new Loan();
        loan.setBookId(book.getId());
        loan.setBorrowerId(ownerId); // 不信任请求中的 borrower_id
        loan.setOwnerId(ownerId);
        loan.setStatus("ACTIVE");
        mapper.insert(loan);
        book.setStatus("BORROWED");
        bookMapper.updateById(book);
        return toView(loan);
    }

    public LoanView get(Long id, Long ownerId) {
        return toView(requireOwned(id, ownerId));
    }

    @Transactional
    public LoanView update(Long id, LoanUpdateRequest request, Long ownerId) {
        Loan loan = requireOwned(id, ownerId);
        if (!"ACTIVE".equals(loan.getStatus()) || !"RETURNED".equals(request.status())) {
            throw new ApiException("CONFLICT", "仅可归还进行中的借阅", 409);
        }
        Book book = lockedBook(loan.getBookId());
        if (!"BORROWED".equals(book.getStatus())) {
            throw new ApiException("CONFLICT", "图书状态与借阅不一致", 409);
        }
        loan.setStatus("RETURNED");
        mapper.updateById(loan);
        book.setStatus("AVAILABLE");
        bookMapper.updateById(book);
        return toView(loan);
    }

    public void delete(Long id, Long ownerId) {
        throw new ApiException(ErrorCode.FORBIDDEN, "借阅记录不可删除", 403);
    }

    private Book lockedBook(Long id) {
        Book book = bookMapper.selectOne(new QueryWrapper<Book>().eq("id", id).last("FOR UPDATE"));
        if (book == null) {
            throw new ApiException(ErrorCode.NOT_FOUND, "图书不存在", 404);
        }
        return book;
    }

    private Loan requireOwned(Long id, Long ownerId) {
        Loan loan = mapper.selectById(id);
        if (loan == null) {
            throw new ApiException(ErrorCode.NOT_FOUND, "借阅记录不存在", 404);
        }
        if (loan.getOwnerId() == null || !loan.getOwnerId().equals(ownerId)) {
            throw new ApiException(ErrorCode.FORBIDDEN, "无权访问该借阅", 403);
        }
        return loan;
    }

    private LoanView toView(Loan loan) {
        return new LoanView(loan.getId(), loan.getBorrowerId(), loan.getOwnerId(),
                loan.getStatus(), loan.getCreatedAt(), loan.getBookId());
    }
}
