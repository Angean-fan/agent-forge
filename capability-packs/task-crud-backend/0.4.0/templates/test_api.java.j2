package {{ package }};

import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.delete;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

import {{ package }}.entity.AppUser;
import {{ package }}.mapper.AppUserMapper;
import com.fasterxml.jackson.databind.ObjectMapper;
import java.util.Map;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.http.MediaType;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.test.context.ActiveProfiles;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.transaction.annotation.Transactional;

@SpringBootTest
@AutoConfigureMockMvc
@ActiveProfiles("test")
@Transactional
class LoanApiTest {
    @Autowired private MockMvc mvc;
    @Autowired private ObjectMapper json;
    @Autowired private AppUserMapper users;
    @Autowired private PasswordEncoder encoder;
    private String adminToken;
    private String memberToken;

    @BeforeEach
    void setUp() throws Exception {
        adminToken = login("lending-admin", "admin123", "ADMIN");
        memberToken = login("lending-member", "member123", "MEMBER");
    }

    private String login(String name, String password, String role) throws Exception {
        AppUser user = new AppUser();
        user.setUsername(name);
        user.setPasswordHash(encoder.encode(password));
        user.setRole(role);
        user.setEnabled(true);
        users.insert(user);
        String body = mvc.perform(post("/api/auth/login")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(json.writeValueAsString(Map.of("username", name, "password", password))))
                .andExpect(status().isOk()).andReturn().getResponse().getContentAsString();
        return json.readTree(body).get("token").asText();
    }

    private long createBook() throws Exception {
        String body = mvc.perform(post("/api/books")
                        .header("Authorization", "Bearer " + adminToken)
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(json.writeValueAsString(Map.of(
                                "title", "book", "isbn", "R27-TEST", "status", "AVAILABLE"))))
                .andExpect(status().isOk()).andReturn().getResponse().getContentAsString();
        return json.readTree(body).get("id").asLong();
    }

    private String loanBody(long bookId) throws Exception {
        return json.writeValueAsString(Map.of("book_id", bookId, "status", "ACTIVE", "borrower_id", 999));
    }

    private long borrow(long bookId) throws Exception {
        String body = mvc.perform(post("/api/loans")
                        .header("Authorization", "Bearer " + memberToken)
                        .contentType(MediaType.APPLICATION_JSON).content(loanBody(bookId)))
                .andExpect(status().isOk()).andReturn().getResponse().getContentAsString();
        return json.readTree(body).get("id").asLong();
    }

    @Test
    void borrowingLocksBookAndRejectsSecondBorrow() throws Exception {
        long bookId = createBook();
        mvc.perform(get("/api/books/" + bookId).header("Authorization", "Bearer " + memberToken))
                .andExpect(status().isOk()).andExpect(jsonPath("$.status").value("AVAILABLE"));
        long loanId = borrow(bookId);
        mvc.perform(get("/api/books/" + bookId).header("Authorization", "Bearer " + adminToken))
                .andExpect(status().isOk()).andExpect(jsonPath("$.status").value("BORROWED"));
        mvc.perform(post("/api/loans").header("Authorization", "Bearer " + memberToken)
                        .contentType(MediaType.APPLICATION_JSON).content(loanBody(bookId)))
                .andExpect(status().isConflict());
        mvc.perform(put("/api/books/" + bookId).header("Authorization", "Bearer " + adminToken)
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(json.writeValueAsString(Map.of(
                                "title", "book", "isbn", "R27-TEST", "status", "AVAILABLE"))))
                .andExpect(status().isConflict());
        mvc.perform(delete("/api/books/" + bookId)
                        .header("Authorization", "Bearer " + adminToken))
                .andExpect(status().isConflict());
        mvc.perform(get("/api/loans/" + loanId).header("Authorization", "Bearer " + memberToken))
                .andExpect(status().isOk()).andExpect(jsonPath("$.borrower_id").value(
                        users.selectOne(new com.baomidou.mybatisplus.core.conditions.query.QueryWrapper<AppUser>()
                                .eq("username", "lending-member")).getId()));
    }

    @Test
    void returnReleasesBookForAnotherBorrow() throws Exception {
        long bookId = createBook();
        long loanId = borrow(bookId);
        mvc.perform(put("/api/loans/" + loanId).header("Authorization", "Bearer " + memberToken)
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(json.writeValueAsString(Map.of("status", "RETURNED"))))
                .andExpect(status().isOk()).andExpect(jsonPath("$.status").value("RETURNED"));
        mvc.perform(get("/api/books/" + bookId).header("Authorization", "Bearer " + adminToken))
                .andExpect(status().isOk()).andExpect(jsonPath("$.status").value("AVAILABLE"));
        borrow(bookId);
    }

    @Test
    void memberCannotCreateBookAndAdminCannotReadMemberLoan() throws Exception {
        long bookId = createBook();
        long loanId = borrow(bookId);
        mvc.perform(post("/api/books").header("Authorization", "Bearer " + memberToken)
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(json.writeValueAsString(Map.of(
                                "title", "x", "isbn", "x", "status", "AVAILABLE"))))
                .andExpect(status().isForbidden());
        mvc.perform(get("/api/loans/" + loanId).header("Authorization", "Bearer " + adminToken))
                .andExpect(status().isForbidden());
    }

    @Test
    void memberSeesOwnLoansAndPaginationBound() throws Exception {
        borrow(createBook());
        mvc.perform(get("/api/loans?keyword=ACTIVE").header("Authorization", "Bearer " + memberToken))
                .andExpect(status().isOk()).andExpect(jsonPath("$.total").value(1));
        mvc.perform(get("/api/loans?page=1&size=100000")
                        .header("Authorization", "Bearer " + memberToken))
                .andExpect(status().isBadRequest());
    }
}
