{
  "id": "task-crud-frontend",
  "version": "0.1.0",
  "kind": "capability-pack",
  "compatible_profiles": ["demo-ts-mp"],
  "requires": ["template:router", "template:auth", "template:api-client"],
  "provides": ["crud-ui", "list", "form", "search-ui", "pagination-ui"],
  "conflicts": [],
  "parameter_schema": {
    "entity_name": "string",
    "entity_camel": "string",
    "plural": "string",
    "route_path": "string",
    "ui_path": "string",
    "writable_fields": "FieldContract[]",
    "view_fields": "FieldContract[]"
  },
  "owned_paths": [
    "src/api/",
    "src/views/",
    "src/types/",
    "src/router/modules/",
    "test/"
  ],
  "dependencies": [],
  "checks": ["npm run type-check", "npm run build", "npm test"],
  "license": "internal",
  "renders": [
    {"template": "types.ts.j2", "target": "src/types/{{ entity_camel }}.ts"},
    {"template": "api.ts.j2", "target": "src/api/{{ entity_camel }}.ts"},
    {"template": "view_list.vue.j2", "target": "src/views/{{ entity_name }}ListView.vue"},
    {"template": "router_module.ts.j2", "target": "src/router/modules/{{ entity_camel }}.ts"},
    {"template": "api_test.ts.j2", "target": "test/{{ entity_camel }}-api.spec.ts"}
  ]
}
