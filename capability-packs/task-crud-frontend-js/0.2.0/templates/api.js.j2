import { request } from './client';

export function list{{ entity_name }}s(page = 1, size = 10, keyword = '') {
  const query = new URLSearchParams({ page: String(page), size: String(size) });
  if (keyword) {
    query.set('keyword', keyword);
  }
  return request(`{{ api_path }}?${query.toString()}`);
}

export function create{{ entity_name }}(payload) {
  return request('{{ api_path }}', {
    method: 'POST',
    body: JSON.stringify(payload),
  });
}

export function get{{ entity_name }}(id) {
  return request(`{{ api_path }}/${id}`);
}

export function update{{ entity_name }}(id, payload) {
  return request(`{{ api_path }}/${id}`, {
    method: 'PUT',
    body: JSON.stringify(payload),
  });
}

export function remove{{ entity_name }}(id) {
  return request(`{{ api_path }}/${id}`, { method: 'DELETE' });
}
