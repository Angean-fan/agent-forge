# Copy to .env and fill with a private value. Never commit .env.
DEEPSEEK_API_KEY=

# A01：平台元数据库连接串（默认 sqlite+pysqlite:///./agentforge.db）。
# 切换本地/云端转发 PostgreSQL（如本机 15432 转发端口）时请通过环境变量或 platform-api/.env 设置
# （切勿在代码或版本库硬编码真实密码；若目标库未创建，ensure_postgres_database 会自动建库）：
# AGENTFORGE_DATABASE_URL=postgresql+psycopg://postgres:<replace_with_pg_password>@127.0.0.1:15432/agentforge
# PG 专项集成测试连接串（建议指向独立测试库 agentforge_test；未设置时真实 PG 联机用例标记 NOT_RUN/skipped）：
# AGENTFORGE_TEST_PG_URL=postgresql+psycopg://postgres:<replace_with_pg_password>@127.0.0.1:15432/agentforge_test

# On macOS, set this if Python's bundled CA store cannot verify DeepSeek.
# SSL_CERT_FILE=/etc/ssl/cert.pem

# R03/R06：经真实接口探针验证可用的思考强度（逗号分隔）。未列入的强度会被网关阻止启用。
# 2026-10-12 探针：deepseek-flash 接受 reasoning_effort=low/high（均 HTTP 200）。
# R03 启用 low（冲突澄清）；R06 追加 high，仅用于复杂规格的最终摘要（复用同一探针结论与账本路径）。
AGENTFORGE_VERIFIED_REASONING_EFFORTS=low,high
