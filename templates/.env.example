# 生成项目部署环境变量样例。
# 复制为 .env 并填写；.env 已被忽略，切勿提交真实值。
# 这些是“生成项目”自己的配置，与 AgentForge 平台的账号/密钥无关。

# ---- MySQL ----
DB_NAME=agentforge
DB_USERNAME=agentforge
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---- 后端 JWT（至少 32 字节，仅部署环境注入）----
JWT_SECRET=
JWT_TTL_SECONDS=3600

# ---- 初始化管理员账号（首次启动写入 app_user；不提交真实口令）----
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
