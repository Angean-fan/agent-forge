<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agentforge.template.mapper.AppUserMapper">

    <resultMap id="AppUserResult" type="com.agentforge.template.entity.AppUser">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="role" property="role"/>
        <result column="enabled" property="enabled"/>
    </resultMap>

    <select id="findByUsername" resultMap="AppUserResult">
        SELECT id, username, password_hash, role, enabled
        FROM app_user
        WHERE username = #{username}
    </select>

    <select id="countByUsername" resultType="long">
        SELECT COUNT(*) FROM app_user WHERE username = #{username}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO app_user (username, password_hash, role, enabled)
        VALUES (#{username}, #{passwordHash}, #{role}, #{enabled})
    </insert>
</mapper>
