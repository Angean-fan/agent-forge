# 平台部署配置（复制为 deploy/.env，已被 Git 忽略）。**不要提交真实密钥。**

# 唯一启用的业务模型路由：user_interaction → DeepSeek 官方 deepseek-flash。
# 密钥经此注入平台 API；worker 不调用模型，Runner 绝不接收该密钥。
DEEPSEEK_API_KEY=
# macOS/部分容器如需自定义 CA：
# SSL_CERT_FILE=/etc/ssl/cert.pem

# 独立 Runner 的地址与内部令牌（Runner 在受控主机运行；worker 经此访问）。
# 同机 Docker Desktop 可用 host.docker.internal；跨机填受控主机地址。
RUNNER_BASE_URL=http://host.docker.internal:9000
RUNNER_TOKEN=

# 会话与限流
AGENTFORGE_SESSION_TTL_SECONDS=43200
AGENTFORGE_LOGIN_MAX_ATTEMPTS=10
AGENTFORGE_LOGIN_WINDOW_SECONDS=60

# 运行产物配额/保留（retention.py）
AGENTFORGE_RUN_QUOTA_BYTES=5368709120
AGENTFORGE_MIN_FREE_BYTES=536870912
AGENTFORGE_RUN_RETENTION_DAYS=14

# 草稿阶段模型预算与限次（model_gateway.py）
AGENTFORGE_PROJECT_BUDGET_MICRO=10000000
AGENTFORGE_DRAFT_MAX_CALLS=20

# R03：经真实接口探针验证可用的思考强度（逗号分隔）；未列入的强度会被网关阻止启用。
# 2026-10-12 探针：deepseek-flash 接受 reasoning_effort=low/high（均 HTTP 200）；本阶段仅启用 low。
AGENTFORGE_VERIFIED_REASONING_EFFORTS=low

# ---- A01–A08 底座改造可选配置（默认均关闭，保持 SQLite 与既有行为零回归） ----
# A01：切换至 PostgreSQL 16（配合 deploy/compose.local-pg.yaml 或 --profile postgres 使用）
# POSTGRES_USER=agentforge
# POSTGRES_PASSWORD=<your_local_password>
# POSTGRES_DB=agentforge
# AGENTFORGE_DATABASE_URL=postgresql+psycopg://agentforge:<your_local_password>@postgres:5432/agentforge

# A04：自定义 OpenAI 兼容多模型路由配置（参考 platform-api/config/models.example.json）
# AGENTFORGE_MODELS_CONFIG=/config/models.json

# A05：工厂模式模块软上限（默认 8）
# AGENTFORGE_FACTORY_MAX_MODULES=8

# A08：本地受限子进程单模块快检开关（默认关闭；严禁用于总验收）
# AGENTFORGE_LOCAL_DEPT_TEST_RUNNER=0
